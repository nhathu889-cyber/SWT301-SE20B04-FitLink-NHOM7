{
  "name": "fitlink-backend",
  "private": true,
  "version": "1.0.0",
  "author": "",
  "description": "",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node ./node_modules/nodemon/bin/nodemon.js --exec \"node ./node_modules/@babel/node/bin/babel-node.js\" ./src/server.js",
    "lint": "eslint src --ext js --report-unused-disable-directives --max-warnings 0",
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true});require('fs').mkdirSync('build',{recursive:true})\"",
    "build-babel": "babel ./src -d ./build/src",
    "build": "npm run clean && npm run build-babel",
    "production": "npm run build && node ./build/src/server.js",
    "dev": "node ./node_modules/nodemon/bin/nodemon.js --exec \"node ./node_modules/@babel/node/bin/babel-node.js\" ./src/server.js",
    "seed:pt-demo": "node scripts/seed-pt-demo.mjs",
    "db:migrate:sqlserver": "node scripts/migrate-sqlserver.mjs",
    "test:sql": "node scripts/test-sql.mjs",
    "test:api:sql": "npm run build && node scripts/test-api-sql.cjs",
    "test:unit:booking": "jest --runInBand scripts/test-booking-schedule.cjs",
    "test:report": "jest --runInBand scripts/test-report-cases.cjs --json --outputFile=../../testcase-jest-results.json",
    "test": "npm run test:unit:booking && node scripts/test-profile-avatar.cjs && npm run test:sql && npm run test:api:sql"
  },
  "dependencies": {
    "@babel/runtime": "^7.22.10",
    "@payos/node": "^1.0.10",
    "async-exit-hook": "^2.0.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "google-auth-library": "^10.3.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.3.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.5",
    "openai": "^6.8.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.1",
    "tedious": "^20.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.10",
    "@babel/core": "^7.22.10",
    "@babel/eslint-parser": "^7.22.10",
    "@babel/node": "^7.22.10",
    "@babel/plugin-transform-runtime": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.47.0",
    "jest": "^30.5.2",
    "nodemon": "^3.0.1"
  }
}
